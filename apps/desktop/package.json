{
  "name": "@kiyas/desktop",
  "productName": "Kiyas",
  "version": "0.1.0",
  "private": true,
  "description": "Kiyas desktop app — point-and-click design fidelity checks for non-technical users.",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test:smoke": "esbuild smoke/launch.test.ts --bundle --format=esm --platform=node --packages=external --outfile=smoke/dist/launch.test.mjs && node --test smoke/dist/launch.test.mjs",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "chalk": "^5.4.1",
    "node-pty": "^1.1.0",
    "playwright": "^1.49.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@kiyas/core": "*",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
