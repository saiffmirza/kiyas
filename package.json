{
  "name": "kiyas",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w kiyas-cli",
    "dev": "npm run dev -w kiyas-cli",
    "desktop": "npm run dev -w @kiyas/desktop",
    "typecheck": "npm run typecheck -w @kiyas/core && npm run typecheck -w kiyas-cli && npm run typecheck -w @kiyas/desktop",
    "eval": "esbuild eval/run.ts --bundle --format=esm --platform=node --packages=external --outfile=eval/dist/run.mjs && node eval/dist/run.mjs",
    "test": "esbuild eval/matcher.test.ts --bundle --format=esm --platform=node --packages=external --outfile=eval/dist/matcher.test.mjs && node --test eval/dist/matcher.test.mjs",
    "bump": "node packages/cli/scripts/bump.js"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "esbuild": "^0.24.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0"
  }
}
